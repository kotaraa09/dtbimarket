# Copy to .env and fill in locally. Never commit .env — CLAUDE.md rule 9.
# Validated once at start-up; the API refuses to boot if one is missing.

DATABASE_URL="postgresql://dtbi:dtbi_local_dev@localhost:5433/dtbimarket?schema=public"

# Any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

NODE_ENV="development"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"

# apps/web -> apps/api. The browser never talks to the database or the advisor.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Object storage for product photos (ADR-0004) -------------------------
# Any S3-compatible bucket. Locally this is the MinIO container from
# docker-compose.yml; in deployment it is a managed bucket and only these
# values change. STORAGE_DRIVER=memory exists for tests and is refused in
# production, because a non-durable store loses every photo on deploy.
STORAGE_DRIVER="s3"
STORAGE_ENDPOINT="http://localhost:9100"
STORAGE_BUCKET="dtbimarket-photos"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="dtbi_local_dev"
STORAGE_SECRET_ACCESS_KEY="dtbi_local_dev_secret"
# MinIO addresses buckets by path; most managed providers do not.
STORAGE_FORCE_PATH_STYLE="true"
# Set when a CDN serves the bucket publicly. Empty means URLs are signed at
# read time, which is the safe default for a private bucket.
STORAGE_PUBLIC_BASE_URL=""
