# Copy to .env.test. Integration tests run against their own database so that a
# test never writes an event row into the database a demo or a real seller uses.
DATABASE_URL="postgresql://dtbi:dtbi_local_dev@localhost:5433/dtbimarket_test?schema=public"
SESSION_SECRET=""
NODE_ENV="test"
API_PORT="4100"

STORAGE_DRIVER="memory"
